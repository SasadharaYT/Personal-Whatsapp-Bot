# Environment variables for WhatsApp Bot
# Copy this file to .env and fill in your values

# =============================================
# OWNER CONFIGURATION (REQUIRED)
# =============================================
# Comma-separated list of owner phone numbers WITH country code (no + or spaces)
# Example: OWNER_NUMBERS=1234567890,0987654321
OWNER_NUMBERS=

# =============================================
# BOT CONFIGURATION
# =============================================
BOT_NAME=MyBot
BOT_VERSION=1.0.0
PREFIX=.
TIMEZONE=Asia/Colombo

# Support contact info
SUPPORT_LINK=https://wa.me/yourphonenumber

# =============================================
# AUTHENTICATION
# =============================================
# Directory to store auth session files (relative to project root)
AUTH_DIR=auth

# =============================================
# DATA & LOGGING
# =============================================
# Directory to store persistent data (relative to project root)
DATA_DIR=data

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# =============================================
# CONNECTION SETTINGS
# =============================================
# Use pairing code instead of QR (true/false). Set phone number below if true.
USE_PAIRING_CODE=false
PAIRING_PHONE_NUMBER=

# Maximum reconnect attempts before giving up (0 = unlimited)
MAX_RECONNECT_ATTEMPTS=10

# =============================================
# FEATURE FLAGS
# =============================================
# Automatically read all messages (true/false)
AUTO_READ=false

# Mark bot as online when connected
MARK_ONLINE=true

# =============================================
# ANTI-LINK DEFAULTS
# =============================================
# Comma-separated external domains to block (optional)
BLOCKED_DOMAINS=

# Maximum anti-link warnings before kick
ANTILINK_WARN_LIMIT=3

# =============================================
# OLLAMA CLOUD AI
# =============================================
# Obtain an API key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Ollama Cloud model
OLLAMA_MODEL=gemma4:31b-cloud
# Enable or disable AI commands bot-wide (true/false)
AI_ENABLED=true

# =============================================
# IMAGE SEARCH (PIXABAY API / PEXELS API)
# =============================================
# Free instant API key from https://pixabay.com/api/docs/ (Recommended - key is issued instantly upon sign-up)
PIXABAY_API_KEY=
# Optional legacy key from https://www.pexels.com/api/
PEXELS_API_KEY=
# Active provider: pixabay (default) or pexels
IMAGE_PROVIDER=pixabay

# =============================================
# YOUTUBE MEDIA DOWNLOADER (yt-dlp)
# =============================================
# Enable or disable media downloads bot-wide (true/false)
MEDIA_ENABLED=true
# Maximum media size in MB before rejecting (WhatsApp file limit is ~50-100MB)
MAX_MEDIA_SIZE_MB=50
# Maximum concurrent media downloads allowed simultaneously
MAX_CONCURRENT_DOWNLOADS=2
# Temporary storage directory for in-flight downloads
TEMP_DIR=temp

